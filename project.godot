; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tower Tiles: Nine Lives"
config/description="Your cat lives at the top of the tower. The dogs want in. Build a squad of kittens and keep all nine lives."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.137, 0.106, 0.157, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

driver/output_latency.web=50

[autoload]

Save="*res://autoload/save.gd"
Sfx="*res://autoload/sfx.gd"
Transition="*res://autoload/transition.gd"
Portraits="*res://autoload/portraits.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=true

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

3d/run_on_separate_thread=false
common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.137, 0.106, 0.157, 1)
